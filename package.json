{
  "name": "mabrig-minigrid-dashboard",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/unit.test.ts",
    "test:db": "node --import tsx scripts/test-db.ts",
    "test:e2e": "playwright test",
    "preview": "node scripts/serve.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:supabase": "node --import tsx scripts/test-supabase.ts",
    "prebuild": "node scripts/validate-env.mjs",
    "build:cloudflare": "npm run build && node scripts/verify-pages-output.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "type": "module"
}
